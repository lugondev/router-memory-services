# Copy to .env and fill in. `memgw doctor` will tell you what is still missing.

# --- the one thing you cannot skip -------------------------------------------
# Used by the built-in embedder and extractor, and by Mem0 for its own LLM.
OPENAI_API_KEY=sk-...

# --- who may call this gateway -----------------------------------------------
# key:tenant pairs, comma separated. A bare key lands on the tenant "default".
# With none of these set, every request is a 401 and the gateway looks healthy.
MEMGW_API_KEYS=choose-a-long-random-string:tenant-a

# --- which backends ----------------------------------------------------------
# pgvector = self-hosted, no third party. mem0 = hosted facts. zep = temporal graph.
MEMGW_PROVIDERS=pgvector
MEMGW_DEFAULT_PROVIDER=pgvector

# Needed only if "zep" is in MEMGW_PROVIDERS.
# ZEP_API_KEY=z_...

# --- optional ----------------------------------------------------------------
# MEMGW_EMBEDDING_MODEL=text-embedding-3-small
# MEMGW_EXTRACTION_MODEL=gpt-4o-mini
#
# Keep the raw episodes. Required to move an end-user off a provider that has no
# export, and the most sensitive thing this gateway stores. Off by default.
# MEMGW_JOURNAL=false
#
# /docs and /redoc need no credential. Turn them off in public deployments.
# MEMGW_DOCS=true
